# ============================================================================
# Akshat Fertilizers B2B — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://jceanzuuacrznbngoyps.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (used only for applying SQL migrations locally)
POSTGRES_URL_NON_POOLING=postgres://...

# --- Site URL (used in email links + Google OAuth redirect) -----------------
# No trailing slash. Production = the live portal domain.
NEXT_PUBLIC_SITE_URL=https://akshat-b2b.vercel.app

# --- Gmail SMTP for notifications (features: emails / enquiry / alerts) ------
# GMAIL_USER         : the sending Gmail address
# GMAIL_APP_PASSWORD : a 16-char Google "App Password" (NOT the login password).
#                      Requires 2-Step Verification ON for the account, then:
#                      Google Account → Security → App passwords → Mail.
#                      Spaces are fine (they're stripped automatically).
GMAIL_USER=fertilizersakshat1@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Admin notifications + login admin-bypass -------------------------------
# Comma-separated. Receives new-registration / new-order / enquiry alerts, AND
# any account that signs in with one of these emails is promoted to ADMIN and
# routed to /admin/dashboard. Defaults to GMAIL_USER if left unset.
ADMIN_NOTIFICATION_EMAIL=fertilizersakshat1@gmail.com

# --- Cron secret (overdue-interest job, if scheduled) -----------------------
CRON_SECRET=some-long-random-string

# ============================================================================
# NOT stored here — configured in the Supabase dashboard instead:
#
#  Google "Sign in with Google":
#    Authentication → Providers → Google → enable, then paste:
#      - Google OAuth Client ID
#      - Google OAuth Client Secret
#    (Create these in Google Cloud Console → Credentials → OAuth client ID →
#     Web application. Authorized redirect URI:
#       https://jceanzuuacrznbngoyps.supabase.co/auth/v1/callback )
#
#  Authentication → URL Configuration:
#    Site URL     = https://akshat-b2b.vercel.app
#    Redirect URLs include:
#       https://akshat-b2b.vercel.app/auth/callback
#       http://localhost:3000/auth/callback   (for local testing)
# ============================================================================
